10 CLS
20 PRINT "JMODEM by Joshua Foster"
30 PRINT "Opening serial port...";
40 OPEN "COM2:4800,N,8,1,CS,DS,CD" AS #1
50 PRINT "Waiting for data..."
60 'Receive header
70 FIELD 1, 12 AS FILENAME$, 2 AS FSLO$, 2 as FSHI$
80 GET 1, 16
100 FILESIZE=CVI(FSHI$)*65536+CVI(FSLO$)
110 PRINT "Receiving "FILENAME$":" FILESIZE " bytes"
120 OPEN FILENAME$ FOR OUTPUT AS #2
130 XOFF$=CHR$(19):XON$=CHR$(17):PAUSE=FALSE
500 IF EOF(1) THEN GOSUB 600
505 PRINT LOC(1) "b waiting"
510 IF LOC(1)>128 THEN PAUSE=TRUE:PRINT #1,XOFF$;
511 CNT=LOC(1):IF CNT>255 THEN CNT=255
520 A$=INPUT$(CNT,#1)
521 PRINT "Recvd "CNT" b"
530 PRINT #2,A$;:IF LOC(1)>0 THEN GOTO 510
540 IF PAUSE THEN PAUSE=FALSE:PRINT #1,XON$;
550 GOTO 500
600 PRINT "got EOF, is it really true?"
601 FOR I=1 TO 5000
610 IF NOT EOF(1) THEN RETURN
620 NEXT I
640 CLOSE